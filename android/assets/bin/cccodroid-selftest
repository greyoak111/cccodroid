#!/system/bin/sh
# cccodroid 工具链自检：每项一行 PASS/FAIL；用法 cccodroid-selftest [-q 只看失败]
[ -n "$BASH_VERSION" ] || exec bash "$0" "$@"
W=$(mktemp -d "${TMPDIR:-$PREFIX/tmp}/st.XXXXXX") || { echo "FAIL mktemp"; exit 1; }
cd "$W"
Q=; [ "$1" = -q ] && Q=1
NP=0; NF=0
t() { # t 名称 命令… —— 每项限时 90 秒，卡住的算失败，不拖垮整个自检
  local name=$1; shift
  local out; out=$(timeout -k 5 90 bash -c "$*" 2>&1 </dev/null); local rc=$?
  if [ $rc -eq 0 ]; then NP=$((NP+1)); [ -z "$Q" ] && echo "PASS $name :: $(echo "$out" | tail -1 | cut -c1-100)"
  else NF=$((NF+1)); echo "FAIL $name (rc=$rc$([ $rc = 124 ] && echo ' 超时')) :: $(echo "$out" | tr '\n' ' ' | cut -c1-300)"; fi
}
# tn 名称 探测 对照 命令… —— 联网项。国内连 Google 稳定不通、github.com 时通时不通，这类失败不是工具坏了（一加 Ace 7 Pro 适配报告 11-04）。
# 本项失败后：「探测」（换个办法连同一个目标）通了 → 目标可达而工具不行，FAIL；探测不通、「对照」（国内外都通的站）通了 →
# 当前网络连不上这个目标，记 INFO 不算失败；两个都不通 → FAIL，提示先查网络
NN=0
NET_BASE="curl -sS -o /dev/null --max-time 20 https://www.baidu.com || curl -sS -o /dev/null --max-time 20 https://www.cloudflare.com"
tn() {
  local name=$1 probe=$2; shift 2
  local out; out=$(timeout -k 5 90 bash -c "$*" 2>&1 </dev/null); local rc=$?
  if [ $rc -eq 0 ]; then NP=$((NP+1)); [ -z "$Q" ] && echo "PASS $name :: $(echo "$out" | tail -1 | cut -c1-100)"; return; fi
  local why; why=$(echo "$out" | tr '\n' ' ' | cut -c1-160)
  if timeout -k 5 30 bash -c "$probe" >/dev/null 2>&1 </dev/null; then
    NF=$((NF+1)); echo "FAIL $name (rc=$rc$([ $rc = 124 ] && echo ' 超时')) :: $why"
  elif timeout -k 5 45 bash -c "$NET_BASE" >/dev/null 2>&1 </dev/null; then
    NN=$((NN+1)); echo "INFO 网络 $name :: 当前网络连不上这个目标（别的网站能连上），工具本身正常 :: $why"
  else NF=$((NF+1)); echo "FAIL $name (rc=$rc$([ $rc = 124 ] && echo ' 超时')) :: 几个网站都连不上，先确认联网正常 :: $why"; fi
}
# 注意：命令里带管道时退出码是最后一段的，前面的命令不存在也会算 PASS —— 要么加 set -o pipefail，要么别让管道收尾
# 模块化工具包（0.3.9 起）：没装的模块整节跳过（打 SKIP，不算失败 —— 不然 Claude 会以为是这台设备坏了）。整包工具包一律算装了
has() { [ ! -f "$PREFIX/libexec/devkit/modules.json" ] || [ -f "$PREFIX/libexec/devkit/modules/$1/.ok" ]; }
skip() { echo "SKIP $1 :: 「$2」模块没装"; }
echo "== 环境"; echo "PREFIX=$PREFIX TMPDIR=$TMPDIR"; echo "PATH=$PATH"; echo "LD_PRELOAD=${LD_PRELOAD:-（无）}"
echo "== 工作区"
# 在工作区里另开一个独占的子目录试：用固定文件名会覆盖、删掉用户恰好同名的文件（审查 #49 P2-17）
WD=$(mktemp -d "${CCAPP_WORKSPACE:-$HOME}/.cccodroid-selftest.XXXXXX") || WD=
if [ -z "$WD" ]; then NF=$((NF+1)); echo "FAIL 工作区可写 :: 建不了临时目录"
else
if has build; then t "工作区可执行" "cd \"$WD\" && printf 'int main(){return 0;}' > st.c && cc st.c -o st && ./st && echo ok"
else t "工作区可执行" "cd \"$WD\" && printf '#!/system/bin/sh\necho ok\n' > st.sh && chmod +x st.sh && ./st.sh"; fi
t "工作区符号链接" "cd \"$WD\" && ln -s /system st-ln && echo ok"
rm -rf "$WD"
fi
echo "== 基础路径"
for p in /bin/sh /bin/bash /usr/bin/env /usr/bin/python3 /tmp /etc/resolv.conf /etc/ssl/certs; do [ -e $p ] && echo "有 $p" || echo "无 $p"; done
echo "== shebang"
printf '#!/usr/bin/env bash\necho ok-env\n' > s1; chmod +x s1; t "shebang /usr/bin/env" ./s1
printf '#!/bin/sh\necho ok-binsh\n' > s2; chmod +x s2; t "shebang /bin/sh" ./s2
printf '#!/bin/bash\necho ok-binbash\n' > s3; chmod +x s3; t "shebang /bin/bash" ./s3
printf '#!/usr/bin/env python3\nprint("ok-py")\n' > s4; chmod +x s4; t "shebang env python3" ./s4
printf '#!/usr/bin/env node\nconsole.log("ok-node")\n' > s5; chmod +x s5; t "shebang env node" ./s5
echo "== C/C++"
printf '#include <stdio.h>\nint main(){printf("hi-c\\n");return 0;}\n' > a.c      # 后面 grep / tar 那几项也用它
if has build; then
t "cc" "cc a.c -o a && ./a"
t "gcc 名字" "set -o pipefail; gcc --version | head -1"
printf '#include <iostream>\n#include <ranges>\n#include <vector>\nint main(){std::vector v{1,2,3};for(int x: v|std::views::reverse)std::cout<<x;std::cout<<"\\n";}\n' > b.cpp
t "c++20" "c++ -std=c++20 b.cpp -o b && ./b"
t "-static 不可用（预期：没有静态 libc，只能动态链接）" "! cc a.c -static -o as 2>/dev/null && echo 如预期"
t "pthread+math" "printf '#include <math.h>\n#include <pthread.h>\nvoid*f(void*a){return a;}int main(){pthread_t t;pthread_create(&t,0,f,0);pthread_join(t,0);return (int)sqrt(0);}' > p.c && cc p.c -o p -lm -lpthread && ./p"
t "make" "printf 'all:\n\t@echo made-\$\$(uname -m)\n' > Makefile && make"
mkdir -p cm && printf 'cmake_minimum_required(VERSION 3.10)\nproject(t C)\nadd_executable(t ../a.c)\n' > cm/CMakeLists.txt
t "cmake+ninja" "cmake -S cm -B cm/b -G Ninja >/dev/null && ninja -C cm/b >/dev/null && ./cm/b/t"
t "cmake 默认生成器" "cmake -S cm -B cm/b2 >/dev/null && make -C cm/b2 >/dev/null && ./cm/b2/t"
t "pkg-config" "pkg-config --libs zlib openssl"
t "autotools 风格 ./configure" "printf '#!/bin/sh\necho configured\n' > configure && chmod +x configure && ./configure"
t "gdb" "gdb -batch -ex run -ex bt ./a > g.out 2>&1; grep -q hi-c g.out && tail -2 g.out"
t "strace" "strace -c -o /dev/null ./a"
t "patchelf" "patchelf --print-interpreter ./a"
else skip C/C++ "C/C++ 构建"; fi
echo "== 基础命令"
# 10.22.1 起补进基础模块（以前漏了）；which 在 Termux 是单独的 which 包、不在 debianutils 里，10.22.3 才补上
t "which" "w=\$(command -v which); [ \"\$w\" = \"\$PREFIX/bin/which\" ] || { echo \"which 不是工具包带的：\${w:-没有}\"; exit 1; }; which bash"
t "patch" "printf 'a\\n' > p1 && printf 'b\\n' > p2 && { diff -u p1 p2 > p.diff; true; } && patch -s p1 p.diff && cat p1"
t "tree" "tree --version"
t "其余基础命令" "for c in ed dos2unix lsof nano hostname ifconfig netstat; do command -v \$c >/dev/null || { echo 缺 \$c; exit 1; }; done; echo 都在"
echo "== Python"
t "python3" "python3 -c 'import sys,ssl,sqlite3,zlib,ctypes;print(sys.version.split()[0],ssl.OPENSSL_VERSION)'"
t "python https" "python3 -c 'import urllib.request;print(urllib.request.urlopen(\"https://pypi.org/simple/\",timeout=20).status)'"
t "pip" "pip --version"
t "venv" "python3 -m venv v && ./v/bin/python -c 'print(1)'"
t "pip install(venv)" "./v/bin/pip install -q six && ./v/bin/python -c 'import six;print(six.__version__)'"
t "pip install --user" "pip install -q --user six && python3 -c 'import six;print(six.__file__)'"
t "subprocess shell" "python3 -c 'import subprocess;print(subprocess.check_output(\"echo sp\",shell=True).decode().strip())'"
t "tempfile" "python3 -c 'import tempfile;print(tempfile.gettempdir())'"
echo "== Node"
t "node" "node -e 'console.log(process.version, require(\"os\").tmpdir())'"
t "node https" "node -e 'fetch(\"https://registry.npmjs.org/\").then(r=>console.log(r.status))'"
t "npm" "npm --version"
t "npm install" "mkdir -p np && cd np && npm init -y >/dev/null && npm install --no-audit --no-fund -s is-number semver >/dev/null && node -e 'console.log(require(\"semver\").valid(\"1.2.3\"))'"
t "npm bin (.bin 下的 env shebang)" "cd np && ./node_modules/.bin/semver 1.2.3"
t "npx" "cd np && npx --no-install semver 2.0.0"
t "npm exec shell" "cd np && npm pkg set scripts.t='echo script-ok' && npm run -s t"
t "child_process.exec" "node -e 'require(\"child_process\").exec(\"echo cp\",(e,o)=>console.log(e?e.message:o.trim()))'"
echo "== Java/Android"
if has android; then
printf 'public class H{public static void main(String[] a){System.out.println("hi-java");}}\n' > H.java
t "javac+java" "javac H.java && java H"
t "java 单文件" "java H.java"
t "jar" "jar cf h.jar H.class && ls h.jar"
t "aapt2" "aapt2 version"
t "d8" "d8 --version"
t "apksigner" "apksigner --version"
t "keytool" "keytool -genkeypair -alias a -keyalg RSA -keysize 2048 -dname CN=t -keystore k.p12 -storepass 123456 -validity 1 -storetype pkcs12 >/dev/null && ls k.p12"
else skip Java/Android "安卓打包"; fi
echo "== VCS/网络"
t "git" "git init -q g && cd g && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m x && git log --oneline | wc -l"
tn "git https clone" "curl -sS -o /dev/null --max-time 20 https://github.com" "git clone -q --depth 1 https://github.com/octocat/Hello-World.git hw && ls hw"
tn "curl https" false "curl -sS -o /dev/null -w '%{http_code}' https://www.google.com/generate_204"
t "ssh" "ssh -V"
t "ssh-keygen" "ssh-keygen -q -t ed25519 -N '' -f kk && ls kk.pub"
t "openssl" "openssl version"
echo "== CLI"
if has cli; then
t "rg" "set -o pipefail; rg --version | head -1"; t "fd" "fd --version"; t "bat" "bat --version"; t "delta" "delta --version"
t "hx" "hx --version"; t "yq" "yq --version"; t "jq" "set -o pipefail; echo '{\"a\":1}' | jq .a"; t "sqlite3" "sqlite3 :memory: 'select 1+1'"
t "man" "man ls > m.txt 2>&1; grep -qi 'list directory' m.txt && echo ls 手册在"
else skip "rg/fd/bat/delta/hx/jq/yq/sqlite3/man" "命令行增强"; fi
if has extra; then
t "typst" "printf '= Hi\n' > d.typ && typst compile d.typ && ls d.pdf"
t "duckdb" "duckdb -c 'select 42'"
t "magick" "magick -size 8x8 xc:red r.png && magick identify r.png"
else skip "typst/duckdb/magick" "文档与数据"; fi
t "grep -r" "grep -rc hi-c a.c"; t "find" "find . -maxdepth 1 -name 'a.c'"; t "sed/awk" "set -o pipefail; echo a | sed s/a/b/ | awk '{print \$1}'"
t "tar/xz/zstd/zip" "set -o pipefail; tar cJf x.txz a.c && tar cf - a.c | zstd -q > x.zst && zip -q x.zip a.c && unzip -l x.zip | tail -1"
t "less/file" "file a"
t "pkg（应用自带）" "pkg verified | grep -q '^rust ' && pkg list >/dev/null && echo \"\$(command -v pkg)\""
t "su/sudo 不应存在" "! command -v sudo"
echo "== 音视频（ffmpeg）"
if ! has media; then
  skip ffmpeg "音视频"
elif command -v ffmpeg >/dev/null; then
  t "ffmpeg" "ffmpeg -hide_banner -version | head -1"
  t "ffmpeg 软编 x264 + ffprobe" "ffmpeg -hide_banner -loglevel error -y -f lavfi -i testsrc=duration=1:size=320x240:rate=15 -c:v libx264 -pix_fmt yuv420p sw.mp4 && ffprobe -v error -count_frames -select_streams v -show_entries stream=codec_name,nb_read_frames -of csv=p=0 sw.mp4"
  # MediaCodec 硬件编码因机型而异（看芯片和厂商驱动）：只报告，不算失败
  for c in h264 hevc; do
    out=$(timeout -k 5 60 ffmpeg -hide_banner -loglevel error -y -f lavfi -i testsrc=duration=1:size=1280x720:rate=30 -c:v ${c}_mediacodec -pix_fmt nv12 hw_$c.mp4 2>&1 </dev/null && ffprobe -v error -count_frames -select_streams v -show_entries stream=nb_read_frames -of csv=p=0 hw_$c.mp4 2>&1)
    if [ $? -eq 0 ]; then [ -z "$Q" ] && echo "INFO MediaCodec 硬编 $c :: 可用（${out} 帧）"
    else echo "INFO MediaCodec 硬编 $c :: 本机不可用，用软编（libx264 / libx265）即可 :: $(echo "$out" | tr '\n' ' ' | cut -c1-160)"; fi
  done
else
  echo "INFO ffmpeg :: 工具包较旧，没有 ffmpeg（设置 → 更新开发工具包后再测）"
fi
echo "== 残留路径"
# 下面两项靠 rg（命令行增强模块）
if has cli; then
t "残留 com.termux 文本" "rg --version >/dev/null || exit 1; n=\$(rg -l --no-messages -uu 'com\\.termux' \$PREFIX/bin \$PREFIX/etc \$PREFIX/lib/python3*/site-packages 2>/dev/null | head -20 | tee /dev/stderr | wc -l); echo \$n 个"
t "/tmp 硬编码" "rg --version >/dev/null || exit 1; rg -l --no-messages -uu '\"/tmp' \$PREFIX/bin 2>/dev/null | head -5 | wc -l"
fi
cd /; rm -rf "$W"
echo "== Claude Code"
t "claude 命令" "claude --version"
# 记录 vs 磁盘（组件记录、包清单、模块、自定义组件）由网关核：它有全部记录。网关自己起的自检不再问（本机实况另外报）
TF=${CCAPP_TOKEN_FILE:-$HOME/.gateway-token}
# 端口只认数字（审查 10-29 第六份 低2）：带 @ 之类就能把令牌头送到别处
GP=${CCAPP_PORT:-8791}; case "$GP" in ''|*[!0-9]*) GP=8791;; esac
if [ -z "$CCAPP_ENVFACTS" ] && [ -r "$TF" ]; then
  echo "== 状态对账"
  # 不发令牌原文（审查 10-30 第九份 高2）：127.0.0.1 的端口全机共享，网关没起来时别的应用能先占住。
  # 先发随机数核身份（/__proof，冒牌的算不出），再按 sig2 只签这一个请求；令牌只在 node 里读，不进命令行
  out=$(TF="$TF" GP="$GP" node -e '
const c=require("crypto"),fs=require("fs"),h=require("http");
const T=fs.readFileSync(process.env.TF,"utf8").replace(/[\r\n]/g,""),P=+process.env.GP,L="127.0.0.1",mac=s=>c.createHmac("sha256",T).update(s).digest("hex");
const get=(p,hd)=>new Promise((ok,no)=>{const r=h.get({host:L,port:P,path:p,headers:hd,timeout:60e3},s=>{let b="";s.setEncoding("utf8");s.on("data",d=>b+=d);s.on("end",()=>s.statusCode===200?ok(b):no(new Error("HTTP "+s.statusCode+" "+b.slice(0,120))))});r.on("timeout",()=>r.destroy(new Error("超时")));r.on("error",no)});
(async()=>{const n=c.randomBytes(16).toString("hex");const [boot,m]=(await get("/__proof?for=tool&n="+n)).trim().split(" ");
if(!/^[0-9a-f]{32}$/.test(boot||"")||m!==mac("tproof:"+n+":"+boot+":"+L))throw new Error("端口上的不是本机网关（身份核验没过），没交凭据");
const p="/api/reconcile?run=1&format=selftest",ts=String(Date.now()),r=c.randomBytes(16).toString("hex"),e=c.createHash("sha256").update("").digest("hex");
process.stdout.write(await get(p,{"X-CC-Sig":ts+"."+r+"."+mac("sig2:"+boot+":"+L+":GET:"+ts+":"+r+":"+e+":"+p)}))})().catch(e=>{console.error(e.message);process.exit(1)})' 2>&1)
  if [ $? -ne 0 ]; then NF=$((NF+1)); echo "FAIL 状态对账 :: 问网关失败：$(echo "$out" | head -1 | cut -c1-160)"
  else while IFS= read -r l; do case "$l" in PASS*) NP=$((NP+1)); [ -z "$Q" ] && echo "$l";; FAIL*) NF=$((NF+1)); echo "$l";; esac; done <<< "$out"; fi
fi
echo "== 完：通过 $NP 项，失败 $NF 项$([ $NN -gt 0 ] && echo "，网络连不上 $NN 项（见上面 INFO 网络）")"
[ $NF -eq 0 ]
