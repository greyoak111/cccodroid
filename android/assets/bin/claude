#!/system/bin/sh
# 官方 Claude Code（原样二进制，经 devkit 的 glibc 加载器运行）。
# 先清掉 LD_PRELOAD：shell 里的 termux-exec 是 bionic 库，glibc 进程继承到它会直接起不来。
# --preload 的小库把"被安卓 seccomp 拦下的调用"改成返回 ENOSYS（Android 14 拦 epoll_pwait2，不挂它 claude 一跑就 SIGSYS）。
unset LD_PRELOAD
# 自带的 ripgrep 经加载器调不起来（Grep / Glob 一律「没找到」），改用 PATH 里的 rg，见 bin/rg
export USE_BUILTIN_RIPGREP=0
# 经加载器时（targetSdk 36）：ld.so 用 APK 里那份（CCAPP_LD），预加载列表多一个 exec-shim.so（CCAPP_GLIBC_PRELOAD）
PRE=${CCAPP_GLIBC_PRELOAD:-${CCAPP_CLAUDE_PRELOAD:-${CCAPP_BIN%/bin}/lib/seccomp-enosys.so}}
# 和网关起的一样挂上敏感操作再确认（../guard/cc-guard.mjs），并显式 disableAllHooks:false 压过设置里的关闭（见 gw/claude.mjs）；
# 应用内终端：网关把这家的密钥放在 0600 私有文件里、只给路径（不进环境变量），照网关起 claude 的办法交给 apiKeyHelper。
# 放在最前面：用户自己再带 --settings 时，以用户的为准（claude 只认最后一个 --settings）；在会话里让 Claude 这样起，guard 会先问
# 路径要拼进 JSON 和 shell 命令：只收普通字符（网关给的路径都是这样），带引号之类的不用（审查 v0.5.9 D7）
S=
G=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/guard/cc-guard.mjs
case "$G" in
  /*/guard/cc-guard.mjs) case "$G" in *[!A-Za-z0-9._/-]*) ;; *) [ -r "$G" ] && S="\"disableAllHooks\":false,\"hooks\":{\"PreToolUse\":[{\"matcher\":\"Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|mcp__device__.*\",\"hooks\":[{\"type\":\"command\",\"command\":\"node '$G'\",\"timeout\":10}]}]}" ;; esac ;;
esac
case "$CCAPP_KEY_FILE" in
  ""|*[!A-Za-z0-9._/-]*) ;;
  *) [ -r "$CCAPP_KEY_FILE" ] && S="${S:+$S,}\"apiKeyHelper\":\"cat '$CCAPP_KEY_FILE'\"" ;;
esac
# 发行版封口（见 gateway/gw/edition.mjs）：用户级 / 项目级的 Claude Code 配置不让 claude 自己读，由 guard/cc-seal.mjs 检查后经旗标回填；
# 用户自带的 --settings、--system-prompt 这类能往上下文里塞东西的旗标不认。开发版（cccodroid-dev）把下面这行改成 0。
SEALED=1
if [ "$SEALED" = 1 ]; then
  unset CLAUDE_CONFIG_DIR CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD CLAUDE_COWORK_MEMORY_PATH_OVERRIDE CLAUDE_CODE_DISABLE_AUTO_MEMORY \
    CLAUDE_CODE_USE_COWORK_PLUGINS CLAUDE_CODE_PLUGIN_SEED_DIR CLAUDE_CODE_MANAGED_SETTINGS_PATH
  SEAL=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/guard/cc-seal.mjs
  [ -r "$SEAL" ] || { echo "cccodroid: guard/cc-seal.mjs missing" >&2; exit 2; }
  if [ -n "$S" ]; then OUT=$(node "$SEAL" "$PWD" -- --settings "{$S}" -- "$@") || exit $?
  else OUT=$(node "$SEAL" "$PWD" -- -- "$@") || exit $?; fi
  eval "set -- $OUT"
else
  [ -n "$S" ] && set -- --settings "{$S}" "$@"
fi
exec "${CCAPP_LD:-$PREFIX/glibc/lib/ld-linux-aarch64.so.1}" --library-path "$PREFIX/glibc/lib" ${PRE:+--preload "$PRE"} \
  "$HOME/.local/share/cccodroid/claude/current/claude" "$@"
