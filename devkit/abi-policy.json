    "svt-av1": { "scheme": "major" }
  },
  "runtimeAbi": {
    "python": { "scheme": "minor", "note": "次版本变化（如 3.14→3.15）会改变 site-packages 路径与 C 扩展 ABI" },
    "nodejs": { "scheme": "major", "note": "主版本变化会改变 V8 / NODE_MODULE_VERSION 与 libicu 绑定" },
    "perl": { "scheme": "minor", "note": "次版本变化会破坏 XS 原生扩展 ABI" },
    "ruby": { "scheme": "minor", "note": "次版本变化会破坏原生 gem ABI" }
  },
