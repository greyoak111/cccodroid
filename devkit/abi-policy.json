{
  "_doc": "devkit 基础快照 ABI 漂移判定策略（供 devkit/abi-check.mjs 与市场组件库验证继承共用）。",
  "soProviders": {
    "libicu": { "scheme": "major", "note": "C++ 符号带主版本号（如 u_strToLower_79），libicui18n.so.<N>" },
    "openssl": { "scheme": "major", "note": "libssl.so.<N> / libcrypto.so.<N>" },
    "libc++": { "scheme": "major", "note": "C++ 运行时 ABI" },
    "libllvm": { "scheme": "major", "note": "libLLVM.so.<N>" },
    "clang": { "scheme": "major", "note": "libclang-cpp.so.<N>" },
    "glibc": { "scheme": "minor", "note": "GLIBC_2.x 符号版本随次版本递增（旧底座跑不了依赖新 GLIBC_2.x 的组件）" },
    "libxml2": { "scheme": "major", "note": "libxml2.so.<N>（2.13→2.14 曾改 SONAME，建议结合 ELF SONAME 校验）" },
    "ffmpeg": { "scheme": "major", "note": "libavcodec/libavformat 等 SOVERSION 随大版本变" },
    "openjdk-21": { "scheme": "major", "note": "JDK 主版本 / libjvm" },
    "zlib": { "scheme": "major" },
    "libsqlite": { "scheme": "major" },
    "libcurl": { "scheme": "major" },
    "libnghttp2": { "scheme": "major" },
